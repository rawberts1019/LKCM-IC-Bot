# --- Core ---
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Entra ID (Azure AD) SSO ---
# Create an App Registration in Entra:
#   Redirect URI (Web): http://localhost:3000/api/auth/callback/azure-ad
# Copy the values below from the app registration.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Comma-separated list of email addresses with admin role (CTO, etc.).
# Everyone else signing in via Entra gets the `member` role.
ADMIN_EMAILS=

# --- Database (Postgres + pgvector) ---
# Local dev: docker compose up postgres  (or point at Neon during days 1-14)
# Production: RDS Postgres in the LKCM AWS account
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lkcm_icbot

# --- LLM ---
# Phase 1a (days 1-14): Anthropic direct API (synthetic data only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Phase 1b (after AWS cutover): Bedrock. Switch LLM_PROVIDER to `bedrock`.
LLM_PROVIDER=anthropic   # `anthropic` | `bedrock`
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# --- Storage ---
# Phase 1a: local filesystem (dev) / Vercel Blob
# Phase 1b: S3 bucket in LKCM AWS account
STORAGE_PROVIDER=local   # `local` | `s3`
S3_BUCKET=
S3_REGION=us-east-1

# --- Confidence routing ---
# Answers scoring >= this are auto-sent; below goes to deal-team review queue.
CONFIDENCE_AUTO_SEND_THRESHOLD=0.75
